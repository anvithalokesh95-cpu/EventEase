# ==========================================================
# EventEase - Environment Configuration
# ==========================================================

# Application Secret Key
SECRET_KEY=eventease-super-secret-key-2025-portfolio

# Database Engine: 'mysql' (default/primary)
DB_ENGINE=mysql

# MySQL Database Configuration
# Set MYSQL_PASSWORD to your actual MySQL root or user password
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=eventease_db

# Flask Environment
FLASK_ENV=development
FLASK_DEBUG=1
